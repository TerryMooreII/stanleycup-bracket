VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Backups (scripts/backup-supabase.sh) ---
# Postgres connection string for pg_dump/psql. Use the *Session pooler* URL from
# Dashboard -> Connect -> Session mode (IPv4-friendly; the direct db.<ref> host is IPv6-only).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_PROJECT_REF=bmixjsxxckvvwnvhpuwl
# Optional personal access token (Dashboard -> Account -> Access Tokens). When set,
# the backup also exports the project's auth config via the Management API.
SUPABASE_ACCESS_TOKEN=
